# AgentX-Ray Environment Configuration Template
# DEMO MODE operates out-of-the-box without requiring any external keys or MongoDB.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional - Defaults to embedded in-memory fallback if not provided)
MONGODB_URI=mongodb://localhost:27017/agentxray

# LLM Providers (Optional - Zero-key DEMO MODE is enabled by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
